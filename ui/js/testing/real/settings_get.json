{
  "general": {
    "default_originals": {
      "policy": "recycle_bin"
    },
    "kept_languages": [],
    "light_copy_suffix": "_light",
    "quarantine_days": 30,
    "undo_days": 30,
    "windows_recycle_bin": false
  },
  "integration": {
    "context_menu": false,
    "fs_compression_watcher": false,
    "watched_folders": []
  },
  "optimise": {
    "keep_if_not_smaller": true,
    "lossless_only": true,
    "preserve_ads": true,
    "preserve_permissions": true,
    "preserve_timestamps": true
  },
  "performance": {
    "cpu_priority": "normal",
    "low_memory": false,
    "parallel_jobs": 0,
    "threads": 0
  },
  "safety": {
    "exclusions": [],
    "protected_paths": [],
    "skip_encrypted": true,
    "skip_labelled": true,
    "skip_signed": true,
    "synced_folder_warning": true
  },
  "scan": {
    "collect_owner": false,
    "include_hidden": true,
    "max_depth": null,
    "one_file_system": true,
    "threads": 0,
    "use_cache": true,
    "use_fast_index": true
  },
  "tool_paths": {},
  "type_groups": {
    "archives": [
      "zip",
      "7z",
      "rar",
      "tar",
      "gz",
      "tgz",
      "bz2",
      "xz",
      "zst"
    ],
    "audio": [
      "mp3",
      "m4a",
      "aac",
      "wav",
      "flac",
      "ogg",
      "opus",
      "wma",
      "aiff",
      "aif"
    ],
    "fonts": [
      "ttf",
      "otf",
      "ttc",
      "woff",
      "woff2"
    ],
    "images": [
      "jpg",
      "jpeg",
      "png",
      "gif",
      "bmp",
      "tif",
      "tiff",
      "webp",
      "heic",
      "heif",
      "avif"
    ],
    "installers": [
      "msi",
      "exe",
      "msix",
      "appx",
      "iso",
      "img",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "office": [
      "docx",
      "xlsx",
      "pptx",
      "doc",
      "xls",
      "ppt",
      "odt",
      "ods",
      "odp",
      "rtf"
    ],
    "pdf": [
      "pdf"
    ],
    "raw": [
      "cr2",
      "cr3",
      "nef",
      "arw",
      "dng",
      "raf",
      "orf",
      "rw2"
    ],
    "system": [
      "dll",
      "sys",
      "so",
      "dmp",
      "log",
      "etl",
      "tmp"
    ],
    "video": [
      "mp4",
      "mkv",
      "mov",
      "avi",
      "wmv",
      "webm",
      "m4v",
      "mpg",
      "mpeg",
      "flv"
    ]
  },
  "version": 1
}
