{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyJanitor",
  "mainBinaryName": "myjanitor",
  "version": "0.1.0",
  "identifier": "com.myjanitor.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MyJanitor",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Clean files and make them smaller, safely and offline",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
